{
    // ==========================================================================
    // VS CODE CONFIGURATION
    // High-performance, minimalist development environment (Updated Sep, 27 2026)
    // ==========================================================================
    // --------------------------------------------------------------------------
    // 1. WORKBENCH & INTERFACE LAYOUT
    // --------------------------------------------------------------------------
    "workbench.startupEditor": "none",
    "workbench.sideBar.location": "right",
    "workbench.colorTheme": "One Monokai",
    "workbench.iconTheme": "material-icon-theme",
    "workbench.editor.editorActionsLocation": "hidden",
    "workbench.editor.empty.hint": "hidden",
    "workbench.settings.editor": "json",
    "workbench.settings.applyToAllProfiles": [
        "python.defaultInterpreterPath"
    ],
    "workbench.reduceMotion": "on",
    "workbench.activityBar.location": "top",
    "workbench.secondarySideBar.defaultVisibility": "hidden",
    "workbench.browser.showInTitleBar": false,
    "window.density.editorTabHeight": "compact",
    "window.zoomLevel": 1,
    "breadcrumbs.enabled": false,
    // --------------------------------------------------------------------------
    // 2. FONT & TYPOGRAPHY
    // --------------------------------------------------------------------------
    "editor.fontFamily": "JetBrainsMonoNL Nerd Font Mono",
    "editor.fontLigatures": true,
    "editor.fontSize": 14,
    "editor.fontWeight": "450",
    // --------------------------------------------------------------------------
    // 3. COLOR CUSTOMIZATIONS
    // Darker/moodier palette: deep charcoal/navy base, muted amber accents
    // --------------------------------------------------------------------------
    "workbench.colorCustomizations": {
        // Sidebar & Activity Bar
        "sideBarSectionHeader.background": "#1a1a2e",
        "sideBarSectionHeader.foreground": "#c9a875",
        "activityBarBadge.background": "#5c3a1e",
        "tree.indentGuidesStroke": "#4a4a3a",
        // Status & Title Bar
        "statusBar.background": "#1e2124",
        "titleBar.activeForeground": "#cfc9a0",
        // Terminal
        "terminal.background": "#1c1c24",
        // Tabs
        "tab.activeBackground": "#33344a",
        "tab.activeForeground": "#d4cd8a",
        "tab.activeBorderTop": "#8a6a3a",
        "tab.border": "#2a2a35",
        "editorGroupHeader.tabsBackground": "#2a2b38",
        "editorGroupHeader.border": "#4a4a6a"
    },
    // --------------------------------------------------------------------------
    // 4. SYNTAX HIGHLIGHTING
    // --------------------------------------------------------------------------
    "editor.tokenColorCustomizations": {
        "textMateRules": [
            {
                "scope": "comment",
                "settings": {
                    "foreground": "#888181",
                    "fontStyle": "italic"
                }
            },
            {
                "scope": "string.quoted.docstring.multi.python",
                "settings": {
                    "foreground": "#92B55F",
                    "fontStyle": "italic bold"
                }
            }
        ]
    },
    // --------------------------------------------------------------------------
    // 5. EDITOR BEHAVIOR & FEATURES
    // --------------------------------------------------------------------------
    "editor.minimap.enabled": false,
    "editor.stickyScroll.enabled": false,
    "editor.glyphMargin": false,
    "editor.folding": true,
    "editor.showFoldingControls": "mouseover",
    "editor.dragAndDrop": false,
    "editor.cursorStyle": "line",
    "editor.cursorBlinking": "phase",
    "editor.rulers": [
        88,
        100
    ],
    "editor.unicodeHighlight.allowedLocales": {
        "cs": true
    },
    "diffEditor.ignoreTrimWhitespace": false,
    "diffEditor.maxComputationTime": 0,
    "editor.linkedEditing": true,
    "editor.detectIndentation": false,
    "html.format.templating": true,
    "html.format.indentHandlebars": false,
    // --------------------------------------------------------------------------
    // 6. FILE MANAGEMENT & AUTOMATION
    // --------------------------------------------------------------------------
    "files.autoSave": "onFocusChange",
    "files.trimTrailingWhitespace": true,
    "files.hotExit": "onExitAndWindowClose",
    "files.associations": {
        "**/templates/*.html": "jinja-html",
        "**/templates/**/*.html": "jinja-html"
    },
    "explorer.confirmDragAndDrop": false,
    "explorer.confirmDelete": false,
    // --------------------------------------------------------------------------
    // 7. LANGUAGE-SPECIFIC INDENTATION & FORMATTING
    // --------------------------------------------------------------------------
    "editor.formatOnSave": true,
    "[html]": {
        "editor.tabSize": 2,
        "editor.insertSpaces": true
    },
    "[yaml]": {
        "editor.tabSize": 2,
        "editor.insertSpaces": true
    },
    "[python]": {
        "editor.tabSize": 4,
        "editor.insertSpaces": true,
        "editor.defaultFormatter": "charliermarsh.ruff",
        "editor.formatOnSave": true,
        "editor.codeActionsOnSave": {
            "source.fixAll.ruff": "explicit",
            "source.organizeImports.ruff": "explicit"
        }
    },
    "[jinja-html]": {
        "editor.tabSize": 2,
        "editor.insertSpaces": true,
        "editor.formatOnSave": false
    },
    // --------------------------------------------------------------------------
    // 8. PYTHON & RUFF CONFIGURATION
    // --------------------------------------------------------------------------
    "python.analysis.typeCheckingMode": "standard",
    "python.defaultInterpreterPath": "/usr/bin/python3",
    "python.terminal.useEnvFile": true,
    "python.useEnvironmentsExtension": true,
    "python.analysis.ignore": [
        "*"
    ],
    "python.analysis.diagnosticSeverityOverrides": {},
    "settingsSync.ignoredSettings": [
        "-python.defaultInterpreterPath"
    ],
    "ruff.enable": true,
    "ruff.nativeServer": "on", // Enable Rust-based server (recommended for speed)
    "ruff.organizeImports": true,
    "ruff.importStrategy": "useBundled", // Use bundled Ruff for consistency
    // --------------------------------------------------------------------------
    // 9. INTEGRATED TERMINAL
    // --------------------------------------------------------------------------
    "terminal.integrated.fontFamily": "JetBrainsMono Nerd Font Mono",
    "terminal.integrated.fontSize": 14,
    "terminal.integrated.cursorStyle": "underline",
    "terminal.integrated.cursorBlinking": true,
    "terminal.integrated.copyOnSelection": true,
    "terminal.integrated.fontLigatures.enabled": true,
    "terminal.integrated.stickyScroll.enabled": false,
    "terminal.integrated.initialHint": false,
    "terminal.integrated.enableMultiLinePasteWarning": "never",
    "terminal.integrated.defaultProfile.linux": "zsh",
    "terminal.integrated.profiles.linux": {
        "bash": {
            "path": "bash",
            "icon": "terminal-bash"
        },
        "zsh": {
            "path": "/usr/bin/zsh"
        },
        "pwsh": {
            "path": "pwsh",
            "icon": "terminal-powershell"
        }
    },
    // --------------------------------------------------------------------------
    // 10. SOURCE CONTROL (GIT)
    // --------------------------------------------------------------------------
    "git.autofetch": true,
    "git.confirmSync": false,
    "git.decorations.enabled": false,
    "git.openRepositoryInParentFolders": "never",
    "scm.defaultViewMode": "tree",
    // --------------------------------------------------------------------------
    // 11. EXTENSIONS — GENERAL
    // --------------------------------------------------------------------------
    "extensions.autoUpdate": "off",
    "extensions.autoCheckUpdates": false,
    "extensions.ignoreRecommendations": true,
    "security.workspace.trust.untrustedFiles": "open",
    // --------------------------------------------------------------------------
    // 12. AI / COPILOT & CHAT
    // --------------------------------------------------------------------------
    "github.copilot.enable": {
        "*": false,
        "markdown": true,
        "yaml": true,
        "toml": true,
        "python": true
    },
    "github.copilot.nextEditSuggestions.enabled": false,
    "chat.mcp.gallery.enabled": true,
    "chat.mcp.autostart": "onlyNew",
    "chat.viewSessions.orientation": "stacked",
    "chat.titleBar.openInAgentsWindow.enabled": false,
    // --------------------------------------------------------------------------
    // 13. SPELL CHECK (cSpell)
    // --------------------------------------------------------------------------
    "cSpell.userWords": [
        "ceos",
        "charliermarsh",
        "checkpointer",
        "clab",
        "Containerlab",
        "groq",
        "litellm",
        "mgmt",
        "Monokai",
        "netmiko",
        "nornir",
        "Schafer",
        "Syed",
        "vrnetlab"
    ],
    // --------------------------------------------------------------------------
    // 14. INDENT RAINBOW
    // --------------------------------------------------------------------------
    "indentRainbow.indicatorStyle": "light",
    "indentRainbow.lightIndicatorStyleLineWidth": 1,
    "indentRainbow.colors": [
        "rgba(255,255,64,0.3)",
        "rgba(127,255,127,0.3)",
        "rgba(255,127,255,0.3)",
        "rgba(79,236,236,0.3)"
    ],
    "indentRainbow.errorColor": "rgba(102, 44, 44, 0.6)",
    // --------------------------------------------------------------------------
    // 15. CONTAINERS / CONTAINERLAB
    // --------------------------------------------------------------------------
    "containerlab.showWelcomePage": false,
    "containerlab.skipCleanupWarning": true,
    "containers.containerClient": "com.microsoft.visualstudio.containers.docker",
    "containers.orchestratorClient": "com.microsoft.visualstudio.orchestrators.dockercompose",
    // --------------------------------------------------------------------------
    // 16. MISC / TELEMETRY
    // --------------------------------------------------------------------------
    "redhat.telemetry.enabled": false,
    "window.density.layout": "compact"
}